9,127.3],[103.82,148.22],[122.98,172.66],[145.98,201.25],[172.98,234.47],[204.92,273.12],[242.77,318.16],[242.77,318.16],[242.77,318.16],[242.77,318.16],[242.77,318.16],[242.77,318.16],[242.77,318.16],[242.77,318.16]],[[0.17,0.26],[72.56,120.17],[96.45,140.03],[114.2,163.04],[135.28,189.92],[160.58,221.37],[190.27,257.92],[225.41,300.43],[267.05,349.98],[267.05,349.98],[267.05,349.98],[267.05,349.98],[267.05,349.98],[267.05,349.98],[267.05,349.98],[267.05,349.98]]],"source":"ПП РФ № 1291 в ред. № 1713 от 01.11.2025, раздел I, п. 3"}},"steps":[{"id":"isEv","expr":"engine == 'ev' || engine == 'erev'"},{"id":"isHybrid","expr":"engine == 'hybrid'"},{"id":"eurRate","expr":"rate('EUR')"},{"id":"cvRub","expr":"round(price * rate(cur), 2)"},{"id":"cvEur","expr":"cvRub / eurRate"},{"id":"dutyPct","when":"!isEv && !over3","expr":"pick('etsNew', 'pct', cvEur)"},{"id":"dutyMin","when":"!isEv && !over3","expr":"pick('etsNew', 'min', cvEur)"},{"id":"dutyEur","when":"!isEv && !over3","expr":"max(cvEur * dutyPct, cc * dutyMin)"},{"id":"dutyPerCc","when":"!isEv && over5","expr":"pick('ets5', 'perCc', cc)"},{"id":"dutyPerCc","when":"!isEv && over3","expr":"pick('ets35', 'perCc', cc)"},{"id":"dutyEur","when":"!isEv && over3","expr":"cc * dutyPerCc"},{"id":"duty","when":"!isEv && !over3","expr":"round(dutyEur * eurRate, 2)","explain":"Машине нет 3 лет: {dutyPct|pct} от {cvEur|eur} = {cvEur * dutyPct|eur}, но не меньше {dutyMin|num2} € × {cc|cc} = {cc * dutyMin|eur}. Выходит {dutyEur|eur} по курсу {eurRate|rate} ₽. В единую ставку уже входят НДС и акциз."},{"id":"duty","when":"!isEv","expr":"round(dutyEur * eurRate, 2)","explain":"Машине {over5 ? 'больше 5 лет' : 'от 3 до 5 лет'}: {dutyPerCc|num2} € за см³ × {cc|cc} = {dutyEur|eur} по курсу {eurRate|rate} ₽. В единую ставку уже входят НДС и акциз."},{"id":"duty","when":"isEv","expr":"round(cvRub * c('evDuty'), 2)","explain":"{c('evDuty')|pct} от таможенной стоимости {cvRub|rub}."},{"id":"exciseRate","when":"isEv","expr":"pick('excise', 'rub', ehp)"},{"id":"excise","when":"isEv","expr":"round(ehp * exciseRate, 2)","explain":"{ehp|hp} × {exciseRate|int} ₽ за л.с. По 30-минутной мощности, 1 л.с. = 0,75 кВт."},{"id":"vatRate","when":"isEv","expr":"c('vat')"},{"id":"vat","when":"isEv","expr":"round((cvRub + duty + excise) * vatRate, 2)","explain":"{vatRate|pct} от суммы: стоимость {cvRub|rub} + пошлина + акциз."},{"id":"fee","expr":"pick('fee', 'fee', cvRub)","explain":"Фиксированная ставка для таможенной стоимости {cvRub|rub}."},{"id":"utilKw","expr":"isEv ? ekw : (isHybrid ? kw + ekw : kw)"},{"id":"utilCol","expr":"over3 ? 'old' : 'new'"},{"id":"utilCoef","when":"isEv && personal","expr":"pick('utilEvP', utilCol, utilKw)"},{"id":"utilCoef","when":"isEv","expr":"pick('utilEv', utilCol, utilKw)"},{"id":"utilCoef","when":"personal","expr":"pick('utilIceP', utilCol, cc, utilKw)"},{"id":"utilCoef","expr":"pick('utilIce', utilCol, cc, utilKw)"},{"id":"utilPrivileged","expr":"utilCoef < 1"},{"id":"util","expr":"round(c('utilBase') * utilCoef, 2)","explain":"{c('utilBase')|rub} × коэффициент {utilCoef|coef}: {over3 ? 'старше 3 лет' : 'до 3 лет'}, мощность {utilKw|kw}{isEv ? ' (30-минутная)' : ''}{utilPrivileged ? ', льгота для себя' : ''}."},{"id":"customs","expr":"duty + (isEv ? excise + vat : 0) + fee"},{"id":"total","expr":"customs + util"}],"lines":[{"id":"duty","label":"Пошлина"},{"id":"excise","label":"Акциз"},{"id":"vat","label":"НДС"},{"id":"fee","label":"Таможенный сбор"},{"id":"util","label":"Утильсбор","hint":"Платится в таможню вместе с остальными платежами"}],"total":"total","warnings":[{"when":"!isEv && personal && cc <= 3000 && utilKw > 117.68","level":"warn","text":"Мощность больше 160 л.с. — льготного утильсбора нет даже для себя, считаем по полной ставке."},{"when":"!isEv && personal && cc > 3000","level":"warn","text":"Объём больше 3 литров — льгота по утильсбору не действует."},{"when":"isEv && personal && ekw > 58.84","level":"warn","text":"Электромобилям и последовательным гибридам льготный утильсбор положен только до 80 л.с. 30-минутной мощности."},{"when":"personal && utilPrivileged","level":"good","text":"Льготный утильсбор: машина для себя, одна за 12 месяцев, продать можно не раньше чем через год — иначе доплата до полной ставки."},{"when":"!personal","level":"info","text":"Не для личного пользования (вторая машина за 12 месяцев, перепродажа) — утильсбор по полной ставке."},{"when":"isHybrid","level":"info","text":"Для гибрида мощность под утильсбор — это ДВС плюс 30-минутная мощность электромоторов."},{"when":"engine == 'erev'","level":"info","text":"Последовательный гибрид оформляют как электромобиль: пошлина 15 %, акциз и НДС."},{"when":"!isEv && over3 && !over5","level":"good","text":"Возраст от 3 до 5 лет — самая выгодная пошлина, машина «проходная»."}],"selfTests":[{"name":"Япония, 3–5 лет, 1,5 л, 110 л.с.","date":"2026-09-29","fx":{"EUR":96.2499,"JPY":0.535071},"inputs":{"price":2000000,"cur":"JPY","engine":"petrol","cc":1496,"hp":110,"kw":80.9,"prodYear":2023,"prodMonth":5,"personal":true},"expect":{"cvRub":1070142,"duty":244782.75,"fee":4924,"util":5200,"total":254906.75},"tol":0.02},{"name":"Корея, до 3 лет, 2,0 л, 150 л.с.","date":"2026-09-29","fx":{"EUR":96.2499,"KRW":0.0624316},"inputs":{"price":25000000,"cur":"KRW","engine":"petrol","cc":1999,"hp":150,"kw":110.32,"prodYear":2025,"prodMonth":3,"personal":true},"expect":{"cvRub":1560790,"duty":749179.2,"fee":13541,"util":3400,"total":766120.2},"tol":0.02},{"name":"Китай, электромобиль 150 кВт (30 мин)","date":"2026-09-29","fx":{"EUR":96.2499,"CNY":12.5629},"inputs":{"price":200000,"cur":"CNY","engine":"ev","ekw":150,"ehp":200,"prodYear":2025,"prodMonth":6,"personal":true},"expect":{"duty":376887,"excise":122600,"vat":662654.74,"fee":13541,"util":2193600,"total":3369282.74},"tol":0.02},{"name":"США, до 3 лет, 2,5 л, 205 л.с. — без льготы","date":"2026-09-29","fx":{"EUR":96.2499,"USD":84.4075},"inputs":{"price":30000,"cur":"USD","engine":"petrol","cc":2494,"hp":205,"kw":150.77,"prod